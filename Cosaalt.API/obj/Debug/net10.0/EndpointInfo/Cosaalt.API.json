{
  "openapi": "3.0.1",
  "info": {
    "title": "COSAALT API — Gestión y Cambio de Medidores",
    "description": "API con rutas, sincronización, coordenadas para mapa y subida de evidencias.",
    "version": "Sprint 2"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/catalogos/motivos": {
      "get": {
        "tags": [
          "Catalogos"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "Cosaalt.API"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ejecuciones": {
      "post": {
        "tags": [
          "Ejecuciones"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EjecucionCambioRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/EjecucionCambioRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/EjecucionCambioRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/ejecuciones/historial": {
      "get": {
        "tags": [
          "Ejecuciones"
        ],
        "parameters": [
          {
            "name": "codCon",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/evidencias/upload": {
      "post": {
        "tags": [
          "Evidencias"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "archivo": {
                    "type": "string",
                    "format": "binary"
                  },
                  "tipoFoto": {
                    "type": "string"
                  },
                  "idOrigen": {
                    "type": "string"
                  }
                }
              },
              "encoding": {
                "archivo": {
                  "style": "form"
                },
                "tipoFoto": {
                  "style": "form"
                },
                "idOrigen": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rutas/asignar": {
      "post": {
        "tags": [
          "Rutas"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignarRutaRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/AsignarRutaRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/AsignarRutaRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rutas/tecnico/{idTecnico}": {
      "get": {
        "tags": [
          "Rutas"
        ],
        "parameters": [
          {
            "name": "idTecnico",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          },
          {
            "name": "fecha",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/rutas/{idAsignacion}": {
      "get": {
        "tags": [
          "Rutas"
        ],
        "parameters": [
          {
            "name": "idAsignacion",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/sincronizacion/procesar-cambios": {
      "post": {
        "tags": [
          "Sincronizacion"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SincronizacionRequestDto"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SincronizacionRequestDto"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SincronizacionRequestDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/solicitudes": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "parameters": [
          {
            "name": "filtro",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "top",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/solicitudes/{id}": {
      "get": {
        "tags": [
          "Solicitudes"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/tecnicos": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/usuarios/funcionarios": {
      "get": {
        "tags": [
          "Usuarios"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AsignarRutaRequestDto": {
        "type": "object",
        "properties": {
          "idUsuarioAsignador": {
            "type": "integer",
            "format": "int32"
          },
          "idUsuarioTecnico": {
            "type": "integer",
            "format": "int32"
          },
          "fechaAsignacion": {
            "type": "string",
            "format": "date-time"
          },
          "detalles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetalleRutaRequestDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "DetalleRutaRequestDto": {
        "type": "object",
        "properties": {
          "tipoOrigen": {
            "type": "string",
            "nullable": true
          },
          "idOrigen": {
            "type": "string",
            "nullable": true
          },
          "solicitudId": {
            "type": "string",
            "nullable": true
          },
          "ordenVisita": {
            "type": "integer",
            "format": "int32"
          },
          "latitud": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "longitud": {
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "nombreCliente": {
            "type": "string",
            "nullable": true
          },
          "direccion": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EjecucionCambioRequestDto": {
        "type": "object",
        "properties": {
          "tipoOrigen": {
            "type": "string",
            "nullable": true
          },
          "idOrigen": {
            "type": "string",
            "nullable": true
          },
          "idUsuarioApp": {
            "type": "integer",
            "format": "int32"
          },
          "fechaHoraEjecucion": {
            "type": "string",
            "format": "date-time"
          },
          "numeroMedidorRetirado": {
            "type": "string",
            "nullable": true
          },
          "marcaRetirado": {
            "type": "string",
            "nullable": true
          },
          "lecturaRetiro": {
            "type": "number",
            "format": "double"
          },
          "idMotivo": {
            "type": "integer",
            "format": "int32"
          },
          "numeroMedidorInstalado": {
            "type": "string",
            "nullable": true
          },
          "marcaInstalado": {
            "type": "string",
            "nullable": true
          },
          "observacionesInstalacion": {
            "type": "string",
            "nullable": true
          },
          "latLong": {
            "type": "string",
            "nullable": true
          },
          "evidencias": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EvidenciaFotoDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EvidenciaFotoDto": {
        "type": "object",
        "properties": {
          "tipoFoto": {
            "type": "string",
            "nullable": true
          },
          "rutaArchivo": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginRequestDto": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "string",
            "nullable": true
          },
          "contrasena": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int32"
          },
          "nombreCompleto": {
            "type": "string",
            "nullable": true
          },
          "rol": {
            "type": "string",
            "nullable": true
          },
          "token": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "SincronizacionRequestDto": {
        "type": "object",
        "properties": {
          "idUsuario": {
            "type": "integer",
            "format": "int32"
          },
          "ejecuciones": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EjecucionCambioRequestDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
}